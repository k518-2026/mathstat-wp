# 手元の PC（generate.js）で使う鍵。このファイルを .env という名前でコピーして値を入れる
# .env は .gitignore に入っているので GitHub には送られない
GEMINI_API_KEY=
OPENALEX_API_KEY=
# Gemini も Ollama も使えないときだけ使う（従量課金）。空なら使わない
ANTHROPIC_API_KEY=
# 手元の言語モデル（既定は config.js の値。2026-10-11 の順番: 1番目 Ollama → 2番目 LM Studio → 3番目 外部 API）
# OLLAMA_HOST=http://192.168.128.62:11434
# OLLAMA_MODELS=gemma4:12b,qwen3.5:9b
# LMSTUDIO_HOST=http://192.168.128.16:1234
# LMSTUDIO_MODELS=（空なら、サーバーが返すモデルを順に最大2個）
